{
  "manifest_version": 3,
  "name": "Auto-Reject 9 Menit",
  "version": "1.0",
  "description": "Ekstensi otomatis reject antrean lebih dari 9 menit",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://jokorahmad440-max.github.io/*"],
      "js": ["content.js"]
    }
  ]
}
