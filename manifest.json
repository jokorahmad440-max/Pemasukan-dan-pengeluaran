{
  "manifest_version": 3,
  "name": "Auto Reject Antrean Akurat",
  "version": "1.1",
  "description": "Otomatis reject antrean > 9 menit dengan tombol start/stop.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
